{
  "name": "vanshot-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Универсальный движок для настольных RPG one-shot'ов",
  "main": "server/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.config.js && vite build --config vite.player-panel.config.js",
    "icons": "node scripts/build-icons.js",
    "fonts": "node scripts/copy-fonts.js",
    "start": "npm run build && node --watch server/index.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "lucide-static": "^1.59.0",
    "vite": "^8.1.5"
  }
}
